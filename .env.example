# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose
# NEXT_PUBLIC_MEDIA_BUCKET=site-media              # optional, bucket for site photos

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://neeksxart.com
ADMIN_PASSWORD=choose-a-long-password             # unlocks /admin (orders + inquiries)

# --- Email via Gmail SMTP (orders + inquiries are emailed with every photo attached) ---
# SMTP_PASS is a Google "App password": myaccount.google.com → Security → 2-Step Verification ON
# → App passwords → create one named "NeeksxArt website" → paste the 16 letters here.
SMTP_USER=neeksxart@gmail.com
SMTP_PASS=
OWNER_EMAIL=info@neeksxart.com                     # who receives the emails (comma-separate for several)
# EVENT_TO_EMAIL=                                  # send pop-up orders to a different inbox
# EVENT_EMAILS=off                                 # stop pop-up emails (use the /admin board only)
# EVENT_REQUIRE_LIVE=1                             # never fall back to demo mode

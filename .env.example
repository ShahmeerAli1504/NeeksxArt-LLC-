# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose
# NEXT_PUBLIC_MEDIA_BUCKET=site-media              # optional, bucket for site photos

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://neeksxart.com           # MUST be the real live domain: canonical URLs, sitemap and structured data use it
# GOOGLE_SITE_VERIFICATION=                         # optional: code from Google Search Console → HTML tag method
# BING_SITE_VERIFICATION=                           # optional: code from Bing Webmaster Tools (msvalidate.01)
ADMIN_PASSWORD=choose-a-long-password             # unlocks /admin (orders + inquiries)

# --- Email via Gmail SMTP (orders + inquiries are emailed with every photo attached) ---
# SMTP_PASS is a Google "App password": myaccount.google.com → Security → 2-Step Verification ON
# → App passwords → create one named "NeeksxArt website" → paste the 16 letters here.
SMTP_USER=neeksxart@gmail.com
SMTP_PASS=
OWNER_EMAIL=info@neeksxart.com                     # who receives the emails (comma-separate for several)
# EVENT_TO_EMAIL=                                  # send pop-up orders to a different inbox
# EVENT_EMAILS=off                                 # stop pop-up emails (use the /admin board only)
# EVENT_REQUIRE_LIVE=1                             # never fall back to demo mode

# --- Payments (checkout) ---
# Square Developer Dashboard → your app → Credentials (Sandbox tab for testing, Production tab to go live).
# With both set, checkout charges through Square; leave them empty for the demo form (nothing charged).
# Sandbox vs production is detected from the Application ID ("sandbox-…"); the Location ID is looked up automatically.
SQUARE_APP_ID=                                     # e.g. sandbox-sq0idb-…
SQUARE_ACCESS_TOKEN=                               # server only, never expose
# SQUARE_LOCATION_ID=                              # optional: pin a location (default: first active one)
# SQUARE_ENV=sandbox                               # optional: override the auto-detection (sandbox | production)
# PAYMENTS_MODE=demo                               # optional: force demo even with keys set

# --- Pop-ups & reviews ---
# POPUP_ALWAYS_OPEN=1                              # testing only: keep /event open without starting a pop-up
# NEXT_PUBLIC_YELP_URL=https://www.yelp.com/biz/neeks-x-art-reno   # already the default; set only if it changes
